# No package of the interface runs code of its own while it is
# installed, in make, in CI or by hand. An install script is how the npm
# worms of 2026 spread: a hijacked release ran on every machine that took
# it, before anybody read it. None of our packages needs one. fsevents is
# the only one that has one, and it brings its compiled file with it.
# npm run still runs the scripts in package.json, see docs/BUILD.md,
# Keeping up. #845
ignore-scripts=true
